<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="MainWindow" Height="700" Width="800"
    WindowStyle="None" AllowsTransparency="True" Background="Transparent"
    WindowStartupLocation="CenterScreen">

    <Window.Resources>


        <ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

            <!--COLORS-->
            <SolidColorBrush x:Key="accent"    Color="#ff9a2e"/>
            <SolidColorBrush x:Key="hover"     Color="#ff7a2e"/>
            <SolidColorBrush x:Key="white"     Color="#f2f2f2"/>
            <SolidColorBrush x:Key="gray"      Color="#999999"/>
            <SolidColorBrush x:Key="bg1"       Color="#1c1c1c"/>
            <SolidColorBrush x:Key="bg2"       Color="#2b2b2b"/>
            <SolidColorBrush x:Key="bg_header" Color="#2c2c2c"/>


            <!--ListBoxItem-->
            <Style TargetType="ListBoxItem">
                <Setter Property="Background" Value="Transparent"/>
                <!-- Default Background -->
                <Setter Property="Foreground" Value="#E6FFFFFF"/>
                <!-- Light Text -->
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Margin" Value="2"/>
                <Setter Property="Padding" Value="5,2"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Border"
                        Background="{TemplateBinding Background}"
                        CornerRadius="5"
                        Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <!-- Hover State -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#632828" Offset="0.0"/>
                                                <!-- Dark Burgundy -->
                                                <GradientStop Color="#4B1E1E" Offset="1.0"/>
                                                <!-- Darker Red -->
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>

                                <!-- Selected State --><!--
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Border" Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#E6cc5333" Offset="0.0"/>
                                                --><!-- Orange Highlight --><!--
                                                <GradientStop Color="#E623074d" Offset="1.0"/>
                                                --><!-- Pink Highlight --><!--
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter TargetName="Border" Property="BorderBrush" Value="#FFFFFF"/>
                                    <Setter TargetName="Border" Property="BorderThickness" Value="2"/>
                                </Trigger>-->
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <!-- CLOSE BUTTON STYLE-->
            <Style x:Key="CloseButton" TargetType="Button">
                <!--[BUTTON] STYLES-->
                <Setter Property="TextElement.FontFamily" Value="Arial"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Cursor" Value="Hand"/>
                <!--[BUTTON] TEMPLATE-->
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BorderElement"
                                CornerRadius="8"
                                Background="#1c1c1c"
                                BorderBrush="#FF9A2E"
                                BorderThickness="1">
                                <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <!-- Trigger for IsMouseOver -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BorderElement" Property="Background" Value="#FF9A2E"/>
                                    <Setter TargetName="BorderElement" Property="BorderBrush" Value="#FF9A2E"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>



            <!--Glow BUTTON-->

            <Style x:Key="YouTubeButtonStyle" TargetType="Border">
                <Setter Property="Background" Value="#FF9a2e"/>
                <Setter Property="CornerRadius" Value="5"/>
                <Setter Property="Padding" Value="10,5"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="#FF9a2E"
                                      Direction="0"
                                      ShadowDepth="0"
                                      BlurRadius="50"/>
                    </Setter.Value>
                </Setter>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="TextBlock.Foreground" Value="White"/>
                <Setter Property="TextBlock.FontWeight" Value="Bold"/>
                <Setter Property="TextBlock.HorizontalAlignment" Value="Center"/>
                <Setter Property="TextBlock.VerticalAlignment" Value="Center"/>
                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="RenderTransform">
                            <Setter.Value>
                                <ScaleTransform ScaleX="1.1" ScaleY="1.1"/>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>



            <!--TEXTBLOCK-->
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource accent}"/>
                <Setter Property="Margin" Value="0,0,10,0"/>
            </Style>


            <!--TEXTBOX-->
            <Style TargetType="TextBox">
                <Setter Property="Foreground" Value="{StaticResource white}"/>
                <Setter Property="Background" Value="{StaticResource bg2}"/>
                <Setter Property="BorderBrush" Value="{StaticResource accent}"/>
                <Setter Property="BorderThickness" Value="0.5"/>
                <Style.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                </Style.Resources>
            </Style>


            <!--SCROLLBAR THUMB-->
            <Style x:Key="ScrollBarThumbVertical" TargetType="{x:Type Thumb}">
                <Setter Property="OverridesDefaultStyle" Value="true"/>
                <!--<Setter Property="Margin" Value="3"/>-->

                <Setter Property="IsTabStop" Value="false"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Thumb}">
                            <Border x:Name="rectangle"
                            BorderThickness="1"
                            BorderBrush="{StaticResource accent}"
                            Height="{TemplateBinding Height}"
                            SnapsToDevicePixels="True"
                            Width="{TemplateBinding Width}"
                            CornerRadius="5">

                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                        <GradientStop Color="#88ff9a2e" Offset="0.8" />
                                        <GradientStop Color="#992b2b2b" Offset="0" />
                                    </LinearGradientBrush>
                                </Border.Background>

                            </Border>
                            <ControlTemplate.Triggers>





                                <Trigger Property="IsDragging" Value="true">

                                    <Setter Property="Background" TargetName="rectangle">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                                <GradientStop Color="#CCFF9A2E" Offset="0.8" />
                                                <GradientStop Color="#CC2B2B2B" Offset="0" />
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>

                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--COMBOBOX STYLE-->
            <Style TargetType="ComboBox">
                <Setter Property="Foreground" Value="#f2f2f2"/>
                <Setter Property="Background" Value="#333333"/>
                <Setter Property="BorderBrush" Value="#444444"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Padding" Value="5,2"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <!-- ComboBox Border -->
                                <Border x:Name="MainBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5">
                                    <Grid>
                                        <!-- Text Content -->
                                        <ContentPresenter Margin="5,0,30,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                                        <!-- Toggle Button -->
                                        <ToggleButton Name="DropDownButton"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="Transparent"
                                          BorderBrush="Transparent"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Width="25"
                                          Height="25"
                                          Margin="0,0,5,0"
                                          ClickMode="Press">
                                            <Path x:Name="ArrowIcon"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                      Fill="#f2f2f2"
                                      Width="10"
                                      Height="6"/>
                                            <ToggleButton.Style>
                                                <Style TargetType="ToggleButton">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ToggleButton">
                                                                <Border x:Name="ToggleBorder"
                                                            Background="Transparent"
                                                            CornerRadius="5"
                                                            Width="25"
                                                            Height="25">
                                                                    <Path x:Name="Arrow"
                                                              Data="M 0 0 L 4 4 L 8 0 Z"
                                                              Fill="#f2f2f2"
                                                              Width="10"
                                                              Height="6"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <!-- Hover Effect -->
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="ToggleBorder" Property="Background">
                                                                            <Setter.Value>
                                                                                <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                                                                    <GradientStop Color="#88ff9a2e" Offset="0.8" />
                                                                                    <GradientStop Color="#992b2b2b" Offset="0" />
                                                                                </LinearGradientBrush>
                                                                            </Setter.Value>
                                                                        </Setter>

                                                                    </Trigger>

                                                                    <!-- Checked Effect -->
                                                                    <Trigger Property="IsChecked" Value="True">


                                                                        <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource accent}"/>
                                                                    </Trigger>

                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ToggleButton.Style>
                                        </ToggleButton>
                                    </Grid>
                                </Border>

                                <!-- Popup for Items -->
                                <Popup Name="Popup"
                           Placement="Bottom"
                           IsOpen="{TemplateBinding IsDropDownOpen}"
                           AllowsTransparency="True"
                           Focusable="False"
                           PopupAnimation="Slide">
                                    <Border Background="#444444"
                                BorderBrush="{StaticResource accent}"
                                BorderThickness="1"
                                CornerRadius="5">
                                        <ScrollViewer Margin="0"
                                          SnapsToDevicePixels="True"
                                          Focusable="False">
                                            <StackPanel IsItemsHost="True"
                                            KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <!-- Hover Effect -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource accent}"/>
                                </Trigger>
                                <!-- Focus Effect -->
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource hover}"/>
                                </Trigger>
                                <!-- Open Popup Effect -->
                                <Trigger SourceName="DropDownButton" Property="IsChecked" Value="True">
                                    <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource accent}"/>
                                    <Setter Property="Background" TargetName="MainBorder" Value="#2b2b2b"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ComboBoxItem">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#f2f2f2"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="ItemBorder"
                        Background="{TemplateBinding Background}"
                        CornerRadius="5"
                        SnapsToDevicePixels="True">
                                <ContentPresenter Margin="10,0"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Left"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <!-- Hover Effect -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <!--<Setter TargetName="ItemBorder" Property="Background" Value="#555555"/>-->


                                    <Setter TargetName="ItemBorder" Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                                <GradientStop Color="#33FF9A2E" Offset="0.5" />
                                                <GradientStop Color="#332B2B2B" Offset="0" />
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>

                                    <!--<Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource accent}"/>-->

                                </Trigger>


                                <!-- Selected Effect -->
                                <Trigger Property="IsSelected" Value="True">

                                    <Setter TargetName="ItemBorder" Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                                <GradientStop Color="#88ff9a2e" Offset="0.8" />
                                                <GradientStop Color="#992b2b2b" Offset="0" />
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>

                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <!--SCROLLBAR-->
            <Style TargetType="ScrollBar">
                <Setter Property="Background" Value="{StaticResource bg2}"/>
                <Setter Property="Foreground" Value="{StaticResource bg1}"/>
                <Setter Property="BorderBrush" Value="{StaticResource accent}"/>
                <Setter Property="Opacity" Value="0.9"/>
                <Setter Property="Margin" Value="3"/>

                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Grid x:Name="Bg"
                                              SnapsToDevicePixels="true">
                                <Border BorderBrush     = "{TemplateBinding BorderBrush}"
                                                    BorderThickness = "{TemplateBinding BorderThickness}"
                                                    Background      = "{TemplateBinding Background}"

                                                    Grid.Row        = "1"
                                                    CornerRadius="5"/>

                                <Track x:Name="PART_Track"

                                                   IsDirectionReversed="true"
                                                   IsEnabled="{TemplateBinding IsMouseOver}"
                                                   Grid.Row="1">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollBarThumbVertical}"


                                                           Margin="0"/>
                                    </Track.Thumb>
                                </Track>

                            </Grid>

                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--CheckBox-->

            <Style TargetType="CheckBox">
                <Setter Property="SnapsToDevicePixels" Value="true" />
                <Setter Property="OverridesDefaultStyle" Value="true" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Foreground" Value="White" />

                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <BulletDecorator Background="Transparent">
                                <BulletDecorator.Bullet>
                                    <Border x:Name="Border" Width="15" Height="15" CornerRadius="2"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                                <GradientStop Color="#88ff9a2e" Offset="0.8" />
                                                <GradientStop Color="#992b2b2b" Offset="0" />
                                            </LinearGradientBrush>
                                        </Border.Background>

                                        <Path Width="9" Height="9" x:Name="CheckMark" SnapsToDevicePixels="False"
                                  Stroke="Pink" StrokeThickness="2" Data="M 0 4 L 3 8 8 0" />
                                    </Border>
                                </BulletDecorator.Bullet>
                                <ContentPresenter Margin="4,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                      RecognizesAccessKey="True" />
                            </BulletDecorator>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="false">
                                    <Setter TargetName="CheckMark" Property="Visibility" Value="Collapsed" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="{x:Null}">
                                    <Setter TargetName="CheckMark" Property="Data" Value="M 0 8 L 8 0" />
                                </Trigger>

                                <!--Hover Effect-->
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter TargetName="Border" Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                                <GradientStop Color="#992b2b2b" Offset="0.0" />
                                                <!-- Soft orange -->
                                                <GradientStop Color="#CCFF9A2E" Offset="0.75" />
                                                <!-- Subtle dark orange -->
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter TargetName="Border" Property="BorderBrush" Value="#FFC87A2E" />
                                    <!-- Slightly brighter border -->
                                </Trigger>


                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter TargetName="CheckMark" Property="Stroke" Value="{StaticResource white}" />
                                    <Setter Property="Foreground" Value="Gray" />
                                </Trigger>

                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <!--SEPARATOR-->
            <Style TargetType="Separator">
                <Setter Property="Background" Value="{StaticResource accent}"/>
            </Style>

            <!--Button-->

            <!--Button-->
            <Style TargetType="Button">
                <!-- Default Appearance -->
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <!-- Light Text -->
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="BorderBrush">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                            <GradientStop Color="#88ff9a2e" Offset="0.25" />
                            <GradientStop Color="#CC2B2B2B" Offset="1" />
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <!-- Button Layout -->
                            <Border x:Name="ButtonBorder"
                        CornerRadius="10"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <!-- Hover and Pressed Effects -->
                            <ControlTemplate.Triggers>
                                <!-- Hover Effect -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                                <GradientStop Color="#88ff9a2e" Offset="0.4" />
                                                <GradientStop Color="#CC2B2B2B" Offset="0" />
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter TargetName="ButtonBorder" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect ShadowDepth="4" BlurRadius="6" Color="#60000000"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <!-- Pressed Effect -->
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                                <GradientStop Color="#E5FF9A2E" Offset="0.4" />
                                                <GradientStop Color="#E52B2B2B" Offset="0" />
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter TargetName="ButtonBorder" Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter TargetName="ButtonBorder" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <!-- Default Background (TextBox-like Gradient) -->
                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                            <GradientStop Color="#88ff9a2e" Offset="1" />
                            <GradientStop Color="#CC2B2B2B" Offset="0" />
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect ShadowDepth="2" BlurRadius="4" Color="#40000000"/>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--ListBox-->
            <Style TargetType="ListBox">
                <Setter Property="Background" Value="#2b2b2b"/>
                <Setter Property="BorderBrush" Value="#ff9a2e"/>
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Visible"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden"/>


                <Style.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="10"/>
                    </Style>
                </Style.Resources>
            </Style>

            <!--ListBoxItem-->

            <!--Border-->
            <Style TargetType="Border" x:Key="EF_GlowBorder">
                <Setter Property="Background" Value="{StaticResource bg2}" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="10" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect
        Color="#FFCE7A"
        Direction="0"
        ShadowDepth="0"
        Opacity="1"
        BlurRadius="50" />
                    </Setter.Value>
                </Setter>
            </Style>



        </ResourceDictionary>

    </Window.Resources>

    <!--MAIN-->
    <Border CornerRadius="20"
            Background="#1C1C1C"
            BorderBrush="#ff9a2e"
            BorderThickness="5"
            Padding="5">

        <Grid>
            <!-- Background Color -->
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                    <GradientStop Color="#1c1c1c" Offset="0" />
                    <GradientStop Color="#222222" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>

            <!-- MAIN ROW DEFINITIONS-->
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <!-- Header-->
                <RowDefinition Height="1*"/>
                <!-- Main-->
                <RowDefinition Height="50"/>
                <!-- Submit Button-->
                <RowDefinition Height="30"/>
                <!-- Footer-->
            </Grid.RowDefinitions>

            <!--HEADER START-->

            <Grid MouseDown="UIe_header_drag" Background="Transparent" Grid.Row="0" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="70"/>
                </Grid.ColumnDefinitions>

                <!-- Logo -->
                <Image x:Name="UI_ef_logo"
                        Margin="5,0,0,0"
                           HorizontalAlignment="Left"/>




                <!-- Title -->
                <TextBlock Text="Place Single Views on Sheets"
                               FontWeight="Bold"
                          Grid.Column="1"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Foreground="#F2F2F2" />


                <!-- Close Button -->
                <!--CLOSE-->
                <Button Content="Close"
                            Style="{StaticResource CloseButton}"
                            Grid.Column="2"
                            Width="60" Height="20"
                            Margin="0,0,10,0"
                            FontSize="10"
                            Click="UIe_header_btn_close"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right"
                            Background="Transparent" Foreground="White" BorderBrush="Transparent"/>


            </Grid>







            <!-- MAIN CONTENT START -->
            <Grid Grid.Row="1" Margin="10,10,10,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="0.75*" />
                </Grid.ColumnDefinitions>

                <!-- ListBox for views -->
                <Border Background="#444444" Padding="10" CornerRadius="10">

                    <StackPanel >

                        <!-- Search Box for ListBox-->
                        <DockPanel Margin="5">
                            <Label Content="🔍Filter:"  Height="25" Foreground="#f2f2f2"/>
                            <TextBox x:Name="UI_search" TextChanged="UIe_search_changed" />
                        </DockPanel>

                        <ListBox x:Name="UI_viewsListBox"
                                 Margin="5" Height="345"
                                 Background="#2b2b2b" Foreground="White"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  >

                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="ContextMenu">
                                        <Setter.Value>
                                            <ContextMenu>
                                                <MenuItem Header="Duplicate" Click="UIe_DuplicateView"/>
                                                <MenuItem Header="Duplicate As Detailed" Click="UIe_DuplicateView"/>
                                                <MenuItem Header="Duplicate As Dependent" Click="UIe_DuplicateView"/>

                                            </ContextMenu>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="10"/>
                                </Style>
                            </ListBox.Resources>



                        </ListBox>

                        <DockPanel HorizontalAlignment="Center">
                            <Button Content="Select All"  Width="100" Margin="0,0,10,0" Click="UIe_select_all" Height="25"/>
                            <Button Content="Select None" Width="100" Click="UIe_select_none"/>
                        </DockPanel>

                        <DockPanel Margin="0,10,0,0">
                            <TextBlock Text="TitleBlock" Width="100" Margin="5,0,10,0" VerticalAlignment="Center" Foreground="{StaticResource accent}" FontWeight="Bold"/>
                            <ComboBox x:Name="UI_combo_title_blocks" Margin="0,0,5,0" />
                        </DockPanel>

                        <DockPanel Margin="0,10,0,0">
                            <TextBlock Text="Prefix:" Width="100" Margin="5,0,10,0" VerticalAlignment="Center" Foreground="{StaticResource accent}" FontWeight="Bold"/>
                            <TextBox x:Name="UI_prefix" Margin="0,0,5,0" Height="25" />
                        </DockPanel>

                        <DockPanel Margin="0,10,0,0">
                            <TextBlock Text="Count Start:" Width="100" Margin="5,0,10,0" VerticalAlignment="Center" Foreground="{StaticResource accent}" FontWeight="Bold"/>
                            <TextBox x:Name="UI_count" Margin="0,0,5,0" Height="25"/>
                        </DockPanel>


                    </StackPanel>

                </Border>

                <!--ScrollView for BorderSheetCards-->
                <Grid Grid.Column="1" Margin="25,0,0,0">
<ListBox x:Name="UI_sheetCardsListBox"
         Margin="10,0,10,0"
         Background="#444444"
         Padding="10"
         AllowDrop="True"
         IsSynchronizedWithCurrentItem="False"
         PreviewMouseLeftButtonDown="ListBox_PreviewMouseLeftButtonDown"
         PreviewMouseMove="ListBox_PreviewMouseMove"
         MouseLeftButtonUp="ListBox_MouseLeftButtonUp">
    <ListBox.ItemTemplate>
        <DataTemplate>
            <TextBlock Text="{Binding}" Foreground="White"/>
        </DataTemplate>
    </ListBox.ItemTemplate>
</ListBox>


                </Grid>


            </Grid>



            <!--Button Area-->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- Buttons-->
                <StackPanel  Grid.Column="1" VerticalAlignment="Center">
                    <Border Style="{StaticResource YouTubeButtonStyle}" >
                        <Button Background="Transparent" Content="Generate Sheets"
                            Click="UIe_btn_run">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Border>
                </StackPanel>

            </Grid>




            <!--FOOTER START-->
            <Border BorderBrush="#ff9a2e" BorderThickness="0,1,0,0" Grid.Row="3" Height="30" VerticalAlignment="Bottom" AllowDrop="True" >
                <!-- Title -->
                <TextBlock TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center" Margin="0,5,0,0">
                    <Hyperlink Foreground="#ff9a2e"
                               FontSize="12"
                               RequestNavigate="UIe_RequestNavigate"
                               NavigateUri="https://learnrevitapi.com/ef-tools-cta"

                               FontWeight="Medium" >
                               Ready to Become pyRevit Hacker?
                    </Hyperlink>
                </TextBlock>
            </Border>


        </Grid>


    </Border>
</Window>
