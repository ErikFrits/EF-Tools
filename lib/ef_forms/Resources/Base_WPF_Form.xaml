<Window Title="The Best WPF Webinar Form!"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="Auto" SizeToContent="Height" MinHeight="100"
        Width="300" WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        AllowsTransparency="True">



    <Grid>

        <!-- Rounded Corner Border -->
        <Border CornerRadius="20"
                BorderBrush="{StaticResource accent}"
                BorderThickness="2"
                Padding="1" >

            <!-- Gradient Background -->
            <Border.Background>
                <LinearGradientBrush StartPoint="1,1" EndPoint="1,0">
                    <GradientStop Color="#1c1c1c" Offset="1"/>
                    <GradientStop Color="#2b2b2b" Offset="0.5"/>
                    <GradientStop Color="#1c1c1c" Offset="0"/>
                </LinearGradientBrush>
            </Border.Background>


            <!-- Outer Grid to allow rounded corners and shadow effects -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition />
                    <RowDefinition Height="30"/>
                </Grid.RowDefinitions>


                <!-- Header Placeholder -->
                <ContentControl x:Name="UI_header" Grid.Row="0"/>

                <!-- Body Content -->
                <ContentControl x:Name="UI_body" Grid.Row="1">

                    <!-- Main body content goes here -->
                </ContentControl>

                <!-- Footer Placeholder -->
                <ContentControl x:Name="UI_footer" Grid.Row="2"/>
            </Grid>
        </Border>
    </Grid>
</Window>
