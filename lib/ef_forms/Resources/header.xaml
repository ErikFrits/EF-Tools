<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

                        <Grid Height="25" x:Name="UI_header_grid" Background="#00000000">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="55"/>
                            </Grid.ColumnDefinitions>

                            <!-- Title -->
                            <Image Margin="10,0,0,0"
                                Source="C:\Users\Erik\Documents\00_LearnRevitAPI\01_RevitAPI_Development\01_pyRevit Extensions\GitHub\EF-Tools.extension\EF_Tools.tab\LearnRevitAPI.panel\Form.pushbutton\ef_logo.png"/>


                            <!-- Title -->
                            <TextBlock  x:Name = "UI_Title"
                                        Text="__title__"
                                        Grid.Column="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="White" />


                            <!-- Close Button -->
                            <Button x:Name ="UI_header_btn_close"
                                 Content="x" Grid.Column="2"
                                 Height="20" Width="20" Margin="0,0,10,0"
                                 HorizontalAlignment="Right"/>



                        </Grid>
</UserControl>